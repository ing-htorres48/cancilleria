{% set imgLogoColombia = 'https://cancilleria.site/modules/custom/cnu_content_blocks/img/escudo-colombia.png' %}
{% set imgLogoIqnet = 'https://cancilleria.site/modules/custom/cnu_content_blocks/img/iqnet.jpg'  %}




<div class="mb-cnu_footer">
  <div class="mb-cnu_footer__main">
      <div class="mb-cnu_footer__main-top">
        <div class="mb-cnu_footer__main-top-logo">
          <img src="{{ imgLogoColombia }}"  alt="Gobierno de Colombia" class="img-esccol">
        </div>
        <div class="mb-cnu_footer__main-top-menu">
          <ul class="mb-cnu-menu">
              {% for key, item in menu %}
                  {% set title = item.link.title %}
                  {% set url = item.link.getUrlObject().toString() %}
                  {% if title and url %}
                      <li> <a href="{{ url }}">{{ title }}</a> </li>
                  {% endif %}
              {% endfor %}
          </ul>
        </div>
      </div>

      <div class="mb-cnu_footer__main-contact">

          {% if config.email %}
            <div class="mb-cnu_footer__main-contact-item">
              <span class="mb-cnu-icon mb-cnu-icon--mail"></span>
              <a href="mailto:{{ config.email }}">{{ config.email }}</a>
            </div>
          {% endif %}

          {% if config.link_x %}
            <div class="mb-cnu_footer__main-contact-item">
              <span class="mb-cnu-icon mb-cnu-icon--x"></span>
              <a href="{{ config.link_x }}" target="_blank">@CancilleriaCol</a>
            </div>
          {% endif %}

          {% if config.facebook %}
            <div class="mb-cnu_footer__main-contact-item">
              <span class="mb-cnu-icon mb-cnu-icon--facebook"></span>
              <a href="{{ config.facebook }}" target="_blank">CancilleriaCol</a>
            </div>
          {% endif %}

          {% if config.youtube %}
            <div class="mb-cnu_footer__main-contact-item">
              <span class="mb-cnu-icon mb-cnu-icon--youtube"></span>
              <a href="{{ config.youtube }}" target="_blank">@CancilleriaCol</a>
            </div>
          {% endif %}
          {% if config.instagram %}
            <div class="mb-cnu_footer__main-contact-item">
              <span class="mb-cnu-icon mb-cnu-icon--instagram"></span>
              <a href="{{ config.instagram }}" target="_blank">@CancilleriaCol</a>
            </div>
          {% endif %}

      </div>

      <div class="mb-cnu_footer__main-separator">
        <div class="mb-cnu_footer__main-separator-row">
            <div class="col-md-4 ml-2">
              <h5 class="text-uppercase colortitle">Ministerio de Relaciones Exteriores</h5>

              <p>Palacio de San Carlos: Calle 10 # 5-51 Bogotá D.C., Colombia<br>
              Horarios y puntos de atención: <a class="colink" href="/ayuda/horarios-atencion">ingrese a este enlace</a>.<br>
              Conmutador: (+57-601) 3814000<br>
              Información de trámites y servicios: (+57-601) 3826999<br>
              Correo institucional: <a href="mailto:contactenos@cancilleria.gov.co">contactenos@cancilleria.gov.co</a><br>
              Denunciar actos de corrupción: <a href="mailto:soytransparente@cancilleria.gov.co">soytransparente@cancilleria.gov.co</a>&nbsp;<br>
              Correo físico: Carrera 5 # 9-03,<br>
              Bogotá Código postal: 111711<br><a class="colink" href="/help/requests" target="_blank">Peticiones, quejas, reclamos, sugerencias, denuncias y felicitaciones - 24 horas </a><br><a class="colink" href="https://sinmre.cancilleria.gov.co/apoderado/proceso.aspx" target="_blank">Consulta procesos disciplinarios</a><br><a class="colink" href="https://main.un.org/securitycouncil/es/content/un-sc-consolidated-list" target="_blank">Listas emitidas por los Comités de Sanciones de las Naciones Unidas</a><br><a href="/ministry/about/privacy" target="_blank">Políticas de Privacidad y Condiciones de Uso</a><br><a href="/sitemap" target="_blank">Mapa del sitio</a>&nbsp;- <a href="https://www.cancilleria.gov.co/sitemap.xml" rel="noopener" target="_blank">XML</a><br></p>

              <p class="last">Última actualización: 2025-12-23</p>
            </div>


            <div class="col-md-4 ml-2">
              <h5 class="text-uppercase colortitle">Directorio Equipo Directivo Embajadas y Consulados en el Exterior</h5>

              <p><a class="colink" href="https://tramites.cancilleria.gov.co/ApostillaLegalizacion/directorio/directivo.aspx" target="_blank">Equipo Directivo</a><br><a class="colink" href="https://tramites.cancilleria.gov.co/ApostillaLegalizacion/directorio/misionesExterior.aspx" target="_blank">Embajadas y Consulados en el Exterior</a><br><a class="colink" href="https://tramites.cancilleria.gov.co/apostillalegalizacion/directorio/misionesAcreditadas.aspx" target="_blank">Cuerpo Diplomático Acreditado en Colombia</a><br><a class="colink" href="https://www.funcionpublica.gov.co/dafpIndexerBHV/?find=FindNext&amp;query=&amp;entidadSeleccionado=0002&amp;bloquearFiltroEntidadSeleccionado=true" target="_blank">Servidores públicos, Funcionarios y Contratistas del MRE</a><br><a class="colink" href="/sites/default/files/planeacion_estrategica/base_de_datos_28_05_2015.pdf" target="_blank">Base de datos del sector</a><br><a href="/help/mailbox" target="_blank">Buzón de notificaciones judiciales</a></p>

              <p class="imagen-icontec"><a href="/ministry/planeacion/sistema-maestro"><img alt=".." data-entity-type="" data-entity-uuid="" src="/sites/default/files/FOTOS2025/FOOTER-LOGO-ICONTEC-WEB-CANCILLERIA-2025 V3.jpg"></a></p>

            </div>
          </div>
