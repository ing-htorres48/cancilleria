{#
  Paragraph type: slider
  Campos:
  - field_img_slider (Media: Image)
  - field_link_slider (Link)
#}

{% set image = content.field_img_slider %}
{% set link_item = paragraph.field_link_slider|first %}

{% if image %}
  {% if link_item and link_item.url %}
    <a
      href="{{ link_item.url.toString() }}"
      {% if link_item.options.attributes.target is defined %}
        target="{{ link_item.options.attributes.target }}"
      {% endif %}
      class="slider-item"
    >
      {{ image }}
    </a>
  {% else %}
    <div class="slider-item">
      {{ image }}
    </div>
  {% endif %}
{% endif %}
