{#
  Block content type: slider_interno
  Field: field_contenido (Paragraph: slider)
#}

{{ attach_library('tu_tema/slider') }}

{% if content.field_contenido %}
  <div class="slider-interno slick-slider">
    {% for item in content.field_contenido %}
      <div class="slide">
        {{ item }}
      </div>
    {% endfor %}
  </div>
{% endif %}
