{% set data = content['#block_content'] %}

<div class="slick-slider-home">
  {% for item in data.field_contenido %}
    <div class="slick-slide-item">
      <a href="{{ item.entity.field_enlace_del_slide.0.url }}">
        <img
          src="{{ file_url(item.entity.field_slide.entity.uri.value) }}"
          alt="{{ item.entity.field_slide.alt }}"
        >
      </a>
    </div>
  {% endfor %}
</div>